# Target state for /etc/nginx/sites-available/ismorg.com
#
# `certbot --nginx` (2026-08-27) added the TLS listen lines and the port-80
# redirect server{} — keep every `# managed by Certbot` line. This file adds:
#   1. root landing page (served by the existing `root` + `index`)
#   2. /solutions/      -> the static catalog build, behind HTTP basic-auth
#   3. /solutions/api/  -> the vote service on 127.0.0.1:4310
#
# Build output goes to  /var/www/ismorg.com/solutions/  (not html/).
# Landing page is        /var/www/ismorg.com/html/index.html
#
# Apply: edit the real file to match the server{} below, then
#   sudo nginx -t && sudo systemctl reload nginx

server {
    server_name ismorg.com www.ismorg.com;

    root /var/www/ismorg.com/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # vote service — more specific prefix, wins regardless of order
    location /solutions/api/ {
        auth_basic           "Solution Ideas";
        auth_basic_user_file /etc/nginx/.htpasswd-solutions;

        proxy_pass         http://127.0.0.1:4310/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # static catalog build. `root` (not alias) keeps try_files well-behaved:
    # /solutions/foo -> /var/www/ismorg.com/solutions/foo
    location = /solutions { return 301 /solutions/; }
    location /solutions/ {
        root /var/www/ismorg.com;
        try_files $uri $uri/ $uri/index.html =404;

        auth_basic           "Solution Ideas";
        auth_basic_user_file /etc/nginx/.htpasswd-solutions;
    }

    # content-hashed assets: cache hard
    location /solutions/_astro/ {
        root /var/www/ismorg.com;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        auth_basic           "Solution Ideas";
        auth_basic_user_file /etc/nginx/.htpasswd-solutions;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/ismorg.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ismorg.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.ismorg.com) { return 301 https://$host$request_uri; } # managed by Certbot
    if ($host = ismorg.com) { return 301 https://$host$request_uri; } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name ismorg.com www.ismorg.com;
    return 404; # managed by Certbot
}
