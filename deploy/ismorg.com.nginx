# Target state for /etc/nginx/sites-available/ismorg.com
#
# `certbot --nginx` (2026-08-27) added the TLS listen lines + the port-80
# redirect server{} — keep every `# managed by Certbot` line.
#
# Solution Ideas is served as two builds:
#   /solutions/       -> PUBLIC build  (open)          /var/www/ismorg.com/solutions/
#   /solutions/team/  -> FULL build    (basic-auth)    /var/www/ismorg.com/solutions-team/
# Both share the vote service on 127.0.0.1:4310.
#
# Apply: edit the real file to match the server{} below, then
#   sudo nginx -t && sudo systemctl reload nginx

server {
    server_name ismorg.com www.ismorg.com;

    root /var/www/ismorg.com/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # ---------- Solution Ideas: TEAM (full) build — password-gated ----------
    location /solutions/team/api/ {
        auth_basic           "Solution Ideas — team";
        auth_basic_user_file /etc/nginx/.htpasswd-solutions;

        proxy_pass         http://127.0.0.1:4310/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Ism-Team "yes";   # unlocks GET /api/submissions
    }

    location = /solutions/team { return 301 /solutions/team/; }
    location /solutions/team/ {
        alias /var/www/ismorg.com/solutions-team/;
        try_files $uri $uri/index.html $uri/ =404;

        auth_basic           "Solution Ideas — team";
        auth_basic_user_file /etc/nginx/.htpasswd-solutions;
        add_header Cache-Control "no-store" always;
    }

    # ---------- Solution Ideas: PUBLIC build — open ----------
    location /solutions/api/ {
        proxy_pass         http://127.0.0.1:4310/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Ism-Team "";      # never trust a client-supplied value here
    }

    location = /solutions { return 301 /solutions/; }
    location /solutions/ {
        root /var/www/ismorg.com;
        try_files $uri $uri/index.html $uri/ =404;
        add_header Cache-Control "no-store" always;
    }
    location /solutions/_astro/ {
        root /var/www/ismorg.com;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/ismorg.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ismorg.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.ismorg.com) { return 301 https://$host$request_uri; } # managed by Certbot
    if ($host = ismorg.com) { return 301 https://$host$request_uri; } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name ismorg.com www.ismorg.com;
    return 404; # managed by Certbot
}
