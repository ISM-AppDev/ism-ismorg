# Build-time flag. When set to 1, ideas with `visibility: internal` in their
# frontmatter are dropped from the build. Leave unset / 0 for the private
# (basic-auth) build that shows everything.
PUBLIC_BUILD=0

# Vote service (service/server.mjs) — only needed if running it outside systemd.
# PORT=4310
# DATA_FILE=./votes.json
