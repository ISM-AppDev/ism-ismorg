---
import Base from '../layouts/Base.astro';
import SolutionCard from '../components/SolutionCard.astro';
import { getSolutions, tabOf, TABS } from '../lib/solutions';
import { CATEGORIES } from '../content/config';

const items = await getSolutions();
// how many ideas sit under each tab
const tabCounts = Object.fromEntries(TABS.map((t) => [t.key, items.filter((i) => tabOf(i.data.status) === t.key).length]));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// only show category pills that actually have ideas, in canonical order
const present = new Set(items.map((i) => i.data.category));
const categories = CATEGORIES.filter((c) => present.has(c));
---
<Base title="Solution Ideas" crumbs={['Catalog']}>
  <div class="band">
    <section class="section--tight container">
      <div class="hero__grid">
        <div class="hero__main">
          <p class="t-label t-crimson hero__kicker">From idea to live</p>
          <h1 class="t-display-2xl hero__title">Solution&nbsp;Ideas</h1>
          <p class="t-body-l hero__blurb">
            A working catalog of applications Impact System Marketing builds — most of
            them aimed at small-business owners. Each one has a one-page brief: the problem,
            how it works, and what it takes to build. See what's live, what's being built, and
            vote on the ideas worth pursuing next.
          </p>
        </div>

        <aside class="hero__cta">
          <p class="t-label t-crimson">Got an idea?</p>
          <p class="hero__cta-copy t-body">Something we should build? Tell us — the strong ones get added here to vote on.</p>
          <a class="btn" href={base + '/submit/'}>Submit your idea&nbsp;&rarr;</a>
        </aside>
      </div>

      <div class="tabs" role="tablist" aria-label="Ideas by stage" data-tabs>
        {TABS.map((t) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`tab-${t.key}`}
            data-tab-btn
            data-tab={t.key}
            aria-selected={t.key === 'ideas' ? 'true' : 'false'}
            aria-controls="catalog-panel"
            tabindex={t.key === 'ideas' ? 0 : -1}
          >
            <span class="tab__num t-display-l">{tabCounts[t.key]}</span>
            <span class="tab__label t-label">{t.label}</span>
          </button>
        ))}
      </div>
    </section>
  </div>

  <section class="section--tight container" data-catalog>
    <div class="controls">
      <div class="controls__filters" role="group" aria-label="Filter by category">
        <button class="pill is-active" data-filter data-category="" aria-pressed="true">All</button>
        {categories.map((c) => (
          <button class="pill" data-filter data-category={c} aria-pressed="false">{c}</button>
        ))}
      </div>
      <div class="controls__right">
        <label class="controls__search">
          <span class="visually-hidden">Search ideas</span>
          <input type="search" placeholder="Search ideas…" data-search autocomplete="off" />
        </label>
        <button class="pill" data-sort aria-pressed="false">
          Sort: <span data-sort-label>catalog order</span>
        </button>
      </div>
    </div>

    <p class="controls__count t-caption t-muted" data-count>{items.length} ideas</p>

    <div class="grid" data-grid id="catalog-panel" role="tabpanel" aria-live="polite">
      {items.map((entry) => <SolutionCard entry={entry} />)}
    </div>

    <p class="grid__empty t-body t-muted" data-empty hidden>No ideas match that filter.</p>
  </section>

  <style>
    .hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
      gap: var(--ism-space-8);
      align-items: start;
      margin-bottom: var(--ism-space-6);
    }
    @media (max-width: 820px) {
      .hero__grid { grid-template-columns: 1fr; gap: var(--ism-space-4); }
    }
    .hero__kicker { margin: 0 0 var(--ism-space-2); }
    .hero__title { margin: 0 0 var(--ism-space-3); }
    .hero__blurb { max-width: 56ch; margin: 0; }

    .hero__cta {
      border: var(--ism-rule) solid var(--ism-text);
      background: var(--ism-bg);
      padding: var(--ism-space-3);
    }
    .hero__cta > * { margin: 0; }
    .hero__cta-copy { margin: 8px 0 var(--ism-space-3); }
    .hero__cta .btn { width: 100%; }

    /* the old stat row, now clickable: one tab per stage */
    .tabs { display: flex; flex-wrap: wrap; gap: var(--ism-space-6); margin: 0; }
    .tab {
      display: flex; flex-direction: column; align-items: flex-start; gap: 4px;
      padding: 0 0 10px;
      background: none; border: 0; border-bottom: 4px solid transparent;
      font: inherit; color: var(--ism-text); text-align: left; cursor: pointer;
    }
    .tab__label { color: var(--ism-charcoal-500); }
    .tab:hover .tab__label { color: var(--ism-text); }
    .tab[aria-selected='true'] { border-bottom-color: var(--ism-action); }
    .tab[aria-selected='true'] .tab__num { color: var(--ism-action); }
    .tab[aria-selected='true'] .tab__label { color: var(--ism-text); }

    .container-rule { max-width: var(--ism-maxw); margin-inline: auto; }

    .controls {
      display: flex; justify-content: space-between; gap: var(--ism-space-3);
      align-items: flex-start; flex-wrap: wrap;
      margin-bottom: var(--ism-space-3);
    }
    .controls__filters { display: flex; gap: 8px; flex-wrap: wrap; }
    .controls__right { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .controls__search input {
      font-family: var(--ism-font-display);
      font-size: 0.9375rem;
      padding: 8px 12px;
      border: var(--ism-rule) solid var(--ism-border);
      background: var(--ism-bg);
      color: var(--ism-text);
      min-width: 200px;
    }
    .controls__search input:focus-visible { outline: var(--ism-rule) solid var(--ism-action); outline-offset: 2px; border-color: var(--ism-action); }
    .controls__count { margin: 0 0 var(--ism-space-3); }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: var(--ism-space-3);
    }
    .grid__empty { padding: var(--ism-space-6) 0; }
  </style>

  <script>
    const root = document.querySelector<HTMLElement>('[data-catalog]');
    const tabsRoot = document.querySelector<HTMLElement>('[data-tabs]');
    if (root && tabsRoot) {
      const grid = root.querySelector<HTMLElement>('[data-grid]')!;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-card]'));
      const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
      const allFilter = filters.find((b) => (b.dataset.category ?? '') === '')!;
      const tabBtns = Array.from(tabsRoot.querySelectorAll<HTMLButtonElement>('[data-tab-btn]'));
      const searchInput = root.querySelector<HTMLInputElement>('[data-search]')!;
      const sortBtn = root.querySelector<HTMLButtonElement>('[data-sort]')!;
      const sortLabel = root.querySelector<HTMLElement>('[data-sort-label]')!;
      const countEl = root.querySelector<HTMLElement>('[data-count]')!;
      const emptyEl = root.querySelector<HTMLElement>('[data-empty]')!;

      const TAB_KEYS = tabBtns.map((b) => b.dataset.tab!);
      const catalogOrder = cards.slice();
      let activeTab = 'ideas';
      let activeCategory = '';
      let query = '';
      let sortByVotes = false;
      let voteCounts: Record<string, number> = {};
      // Only ideas still being weighed carry a vote, so only they count toward "most votes".
      const votesFor = (el: HTMLElement) =>
        el.dataset.tab === 'ideas' ? voteCounts[el.dataset.slug!] ?? 0 : 0;

      const setActiveFilter = (btn: HTMLButtonElement) => {
        activeCategory = btn.dataset.category ?? '';
        filters.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      };

      const apply = () => {
        const inTab = cards.filter((c) => c.dataset.tab === activeTab);

        // category pills: only the categories that have ideas in this tab
        const cats = new Set(inTab.map((c) => c.dataset.category));
        filters.forEach((b) => {
          const c = b.dataset.category ?? '';
          b.style.display = c === '' || cats.has(c) ? '' : 'none';
        });
        if (activeCategory && !cats.has(activeCategory)) setActiveFilter(allFilter);

        // voting only exists on the Ideas tab
        sortBtn.style.display = activeTab === 'ideas' ? '' : 'none';

        let visible = 0;
        for (const card of cards) {
          const matchTab = card.dataset.tab === activeTab;
          const matchCat = !activeCategory || card.dataset.category === activeCategory;
          const matchQuery = !query || (card.dataset.search ?? '').includes(query);
          const show = matchTab && matchCat && matchQuery;
          // inline style beats the scoped `.card { display: flex }` rule —
          // relying on the [hidden] attribute here does not (Astro scopes the
          // override selector to this page's cid, not the card component's).
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        countEl.textContent = `${visible} idea${visible === 1 ? '' : 's'}`;

        emptyEl.hidden = visible !== 0;
        if (visible === 0) {
          const elsewhere = query
            ? cards.filter((c) => c.dataset.tab !== activeTab && (c.dataset.search ?? '').includes(query)).length
            : 0;
          emptyEl.textContent = elsewhere
            ? `No matches in this tab. ${elsewhere} in the other tabs.`
            : 'No ideas match that filter.';
        }
      };

      const reorder = () => {
        const ordered = sortByVotes
          ? cards.slice().sort((a, b) => votesFor(b) - votesFor(a))
          : catalogOrder;
        for (const card of ordered) grid.appendChild(card);
      };

      const setTab = (key: string, updateHash: boolean) => {
        if (!TAB_KEYS.includes(key)) key = 'ideas';
        activeTab = key;
        tabBtns.forEach((b) => {
          const on = b.dataset.tab === key;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.tabIndex = on ? 0 : -1;
        });
        grid.setAttribute('aria-labelledby', `tab-${key}`);
        if (updateHash) {
          // keep the address shareable (#building, #live) without jumping the page
          const url = key === 'ideas' ? location.pathname + location.search : `#${key}`;
          history.replaceState(null, '', url);
        }
        apply();
      };

      const tabFromHash = () => location.hash.replace('#', '').toLowerCase();

      tabBtns.forEach((btn, i) => {
        btn.addEventListener('click', () => setTab(btn.dataset.tab!, true));
        btn.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          e.preventDefault();
          const next = tabBtns[(i + (e.key === 'ArrowRight' ? 1 : tabBtns.length - 1)) % tabBtns.length];
          next.focus();
          setTab(next.dataset.tab!, true);
        });
      });
      window.addEventListener('hashchange', () => setTab(tabFromHash(), false));

      filters.forEach((btn) => {
        btn.addEventListener('click', () => {
          setActiveFilter(btn);
          apply();
        });
      });

      searchInput.addEventListener('input', () => {
        query = searchInput.value.trim().toLowerCase();
        apply();
      });

      sortBtn.addEventListener('click', async () => {
        sortByVotes = !sortByVotes;
        sortBtn.setAttribute('aria-pressed', sortByVotes ? 'true' : 'false');
        sortBtn.classList.toggle('is-active', sortByVotes);
        sortLabel.textContent = sortByVotes ? 'most votes' : 'catalog order';
        if (sortByVotes && !Object.keys(voteCounts).length) {
          try {
            const r = await fetch(`${import.meta.env.BASE_URL}/api/votes`.replace(/\/{2,}/g, '/'));
            if (r.ok) voteCounts = await r.json();
          } catch { /* leave empty; order unchanged */ }
        }
        reorder();
      });

      setTab(tabFromHash(), false);
    }
  </script>
</Base>
