---
/**
 * Anonymous vote control. One vote per browser (token in localStorage),
 * toggled on click. Counts are hydrated client-side from /solutions/api/votes
 * so a static page can still show live totals. When the API is unreachable
 * (e.g. local dev without the service) the control degrades to a disabled
 * placeholder.
 */
interface Props {
  slug: string;
  /** 'card' is compact; 'detail' is the large control on the idea page */
  variant?: 'card' | 'detail';
}
const { slug, variant = 'card' } = Astro.props;
---
<div class={`vote vote--${variant}`} data-vote data-slug={slug}>
  <button type="button" class="vote__btn" data-vote-btn aria-pressed="false" aria-label="Vote for this idea">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M12 5l7 8H5z" />
    </svg>
    <span class="vote__count" data-vote-count>–</span>
  </button>
  {variant === 'detail' && <span class="vote__hint t-caption t-muted" data-vote-hint>One vote per person. Click again to undo.</span>}
</div>

<style>
  .vote { display: inline-flex; align-items: center; gap: 10px; }
  .vote__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--ism-font-condensed);
    font-size: 1rem;
    letter-spacing: 0.04em;
    padding: 6px 12px;
    border: var(--ism-rule) solid var(--ism-border);
    background: var(--ism-bg);
    color: var(--ism-text);
    cursor: pointer;
    line-height: 1;
  }
  .vote__btn:hover { border-color: var(--ism-text); }
  .vote__btn[aria-pressed='true'] {
    border-color: var(--ism-action);
    color: var(--ism-action);
  }
  .vote__btn[disabled] { opacity: 0.45; cursor: default; }
  .vote__count { font-variant-numeric: tabular-nums; min-width: 1.5ch; text-align: left; }
  .vote--detail .vote__btn { font-size: 1.125rem; padding: 10px 18px; }
  .vote__hint { }
</style>

<script>
  const API = `${import.meta.env.BASE_URL}/api`.replace(/\/{2,}/g, '/');
  const TOKEN_KEY = 'ismorg-solutions:voter';

  function voterToken(): string {
    try {
      let t = localStorage.getItem(TOKEN_KEY);
      if (!t) {
        t = (crypto.randomUUID?.() ?? String(Date.now()) + Math.random().toString(16).slice(2));
        localStorage.setItem(TOKEN_KEY, t);
      }
      return t;
    } catch {
      return 'anon';
    }
  }

  function myVotes(): Set<string> {
    try { return new Set(JSON.parse(localStorage.getItem('ismorg-solutions:mine') || '[]')); }
    catch { return new Set(); }
  }
  function saveMyVotes(s: Set<string>) {
    try { localStorage.setItem('ismorg-solutions:mine', JSON.stringify([...s])); } catch {}
  }

  const els = Array.from(document.querySelectorAll<HTMLElement>('[data-vote]'));
  if (els.length) {
    const mine = myVotes();

    // paint local "pressed" state immediately
    for (const el of els) {
      const slug = el.dataset.slug!;
      const btn = el.querySelector<HTMLButtonElement>('[data-vote-btn]')!;
      btn.setAttribute('aria-pressed', mine.has(slug) ? 'true' : 'false');
    }

    // hydrate counts
    fetch(`${API}/votes`, { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((counts: Record<string, number>) => {
        for (const el of els) {
          const slug = el.dataset.slug!;
          const c = el.querySelector<HTMLElement>('[data-vote-count]')!;
          c.textContent = String(counts[slug] ?? 0);
        }
      })
      .catch(() => {
        for (const el of els) {
          const btn = el.querySelector<HTMLButtonElement>('[data-vote-btn]')!;
          const c = el.querySelector<HTMLElement>('[data-vote-count]')!;
          btn.disabled = true;
          c.textContent = '0';
        }
      });

    for (const el of els) {
      const slug = el.dataset.slug!;
      const btn = el.querySelector<HTMLButtonElement>('[data-vote-btn]')!;
      const c = el.querySelector<HTMLElement>('[data-vote-count]')!;
      btn.addEventListener('click', async () => {
        if (btn.disabled) return;
        const pressed = btn.getAttribute('aria-pressed') === 'true';
        const action = pressed ? 'unvote' : 'vote';
        btn.disabled = true;
        try {
          const res = await fetch(`${API}/vote`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug, action, token: voterToken(), website: '' }),
          });
          if (!res.ok) throw new Error(String(res.status));
          const data = await res.json();
          c.textContent = String(data.count ?? 0);
          const nowPressed = !pressed;
          btn.setAttribute('aria-pressed', nowPressed ? 'true' : 'false');
          const m = myVotes();
          nowPressed ? m.add(slug) : m.delete(slug);
          saveMyVotes(m);
        } catch {
          // leave state unchanged
        } finally {
          btn.disabled = false;
        }
      });
    }
  }
</script>
