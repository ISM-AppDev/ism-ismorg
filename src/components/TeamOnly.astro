---
/**
 * Wraps the tail of an idea page that is NOT public: "Why it's worth building",
 * build phases, stack, risks, prototype / app screenshots.
 *
 * - Public build (PUBLIC_BUILD=1): the wrapped content is omitted entirely and
 *   a "sign in for the rest" note is shown, linking to the password-gated
 *   /solutions/team/ version of this same page.
 * - Team build (default / TEAM_BUILD=1): renders the content, with an
 *   "Internal" marker so the boundary is visible.
 */
const PUBLIC = process.env.PUBLIC_BUILD === '1';

// /solutions/foo  ->  /solutions/team/foo   (only used in the public build)
const p = Astro.url.pathname;
const teamHref = p.startsWith('/solutions/team')
  ? p
  : p.startsWith('/solutions')
    ? p.replace(/^\/solutions/, '/solutions/team')
    : '/solutions/team' + (p.startsWith('/') ? p : '/' + p);
---
{PUBLIC ? (
  <p class="gate-note">
    The build plan, stack notes, and open risks for this idea are internal.
    <a href={teamHref}>Team sign-in&nbsp;&rarr;</a>
  </p>
) : (
  <section class="team-only">
    <p class="team-only__tag t-label">Internal — not shown on the public site</p>
    <slot />
  </section>
)}
