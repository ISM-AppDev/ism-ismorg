---
/**
 * Wrap the tail of an idea page that should NOT be shown to the public:
 * "Why it's worth building", build phases, stack, risks, prototype.
 *
 *   <TeamOnly>
 *   ## Why it is worth building
 *   ...
 *   </TeamOnly>
 *
 * - Private build (default): renders the content with an "Internal" marker so
 *   you can see exactly what is gated.
 * - Public build (PUBLIC_BUILD=1): the content is omitted entirely and a short
 *   "sign in to see the rest" note is shown instead.
 */
const PUBLIC = process.env.PUBLIC_BUILD === '1';
---
{PUBLIC ? (
  <p class="gate-note">
    The build plan, stack, risks, and prototype for this idea are internal.
    Use the vote above to say it is worth pursuing.
  </p>
) : (
  <section class="team-only">
    <p class="team-only__tag t-label">Internal — hidden from the public build</p>
    <slot />
  </section>
)}
